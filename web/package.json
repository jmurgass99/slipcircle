{
  "name": "@slipcircle/web",
  "version": "1.0.0",
  "description": "Ultralight VanJS + Three.js + WebAssembly 3D slope stability & slice equilibrium analyzer with SliceGeometryMapping",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "build:wasm": "emcc ./src/solver/cpp/lemKernel.cpp -o ./src/solver/cpp/built/lemKernel.wasm -O3 -s STANDALONE_WASM --no-entry -s EXPORTED_FUNCTIONS=_bishopMAlpha,_sliceDrivingTerm"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vanjs-core": "^1.5.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
